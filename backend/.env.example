# EvidencIA — Variables de entorno (PLANTILLA)
# Copiá este archivo a .env y completá con tus claves reales.
# NUNCA versiones el archivo .env real.

# --- NCBI / PubMed ---
# Clave gratuita: https://www.ncbi.nlm.nih.gov/account/
# Sin clave: 3 req/seg | Con clave: 10 req/seg
NCBI_API_KEY=tu_clave_ncbi_aqui
NCBI_EMAIL=tu_email@ejemplo.com

# --- Google Gemini ---
# Clave gratuita: https://aistudio.google.com/app/apikey
# Sin clave la app igual funciona: usa el diccionario local + MeSh abierto y no genera síntesis IA.
# Chequeá el nombre del modelo vigente en AI Studio (los modelos gratuitos rotan).
GEMINI_API_KEY=tu_clave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash

# --- Vocabulario controlado DeCS (BIREME/OPS) ---
# OPCIONAL. Sin clave se resuelven los términos contra MeSH abierto (NLM Lookup + NCBI db=mesh).
# Con clave se usa DeCS oficial en español: apikey gratuita, se solicita a BIREME.
# Licencia/descarga: https://decs.bvsalud.org/es/condiciones-para-descargar-los-datos-de-decs-mesh/
# Documentación:     https://docs.api.bvsalud.org/  (pestaña "DeCS API (español)")
DECS_API_KEY=tu_clave_decs_aqui
DECS_API_BASE=https://api.bvsalud.org/decs/v2/

# --- Servidor ---
BACKEND_PORT=8000
# En hosting (Render/Railway/Docker) el proveedor inyecta PORT; se respeta ese
# valor por encima de BACKEND_PORT si estás corriendo server_start.py.
#PORT=8000
# Orígenes que pueden llamar a la API desde el navegador, separados por coma.
# En producción agregá el dominio público del frontend, p.ej.:
# ALLOWED_ORIGINS=https://evidencia.app,https://jeronimo.github.io
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Regex adicional de orígenes. El default admite cualquier puerto de localhost
# (Flutter web usa puertos efímeros). Vaciar para restringir solo ALLOWED_ORIGINS.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# --- Comportamiento de búsqueda ---
# true: los niveles de mayor calidad (ETS/HTA, revisiones) se consultan primero.
PRIORIZAR_CALIDAD_POR_DEFECTO=true
